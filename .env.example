# Public read-only admin demo (defaults shown). Set REVIEWER_DEMO=off to disable.
REVIEWER_DEMO=on
REVIEWER_DEMO_EMAIL=reviewer@example.com
REVIEWER_DEMO_PASSWORD=Reviewer123!
